   "source": [
    "from pathlib import Path\n",
    "import duckdb\n",
    "import pandas as pd\n",
    "\n",
    "PROJECT_ROOT = Path.cwd().parent\n",
    "DB_PATH = PROJECT_ROOT / \"data\" / \"ltv.duckdb\"\n",
    "BRONZE_TABLE = \"bronze\"   "
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "bdf3c9f6",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "┌─────────┐\n",
      "│  name   │\n",
      "│ varchar │\n",
      "├─────────┤\n",
      "│ bronze  │\n",
      "└─────────┘\n",
      "\n",
      "Bronze rows: 1,067,371   columns: 8\n"
     ]
    }
   ],
   "source": [
    "con = duckdb.connect(str(DB_PATH))\n",
    "con.sql(\"SHOW TABLES\").show()\n",
    "\n",
    "bronze = con.sql(f\"SELECT * FROM {BRONZE_TABLE}\").df()\n",
    "print(f\"Bronze rows: {len(bronze):,}   columns: {len(bronze.columns)}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "e49d9705",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "PREVIEW (nothing saved yet)\n",
      "Text columns checked: ['Invoice', 'StockCode', 'Description', 'Country']\n",
      "Cells that WILL change: 2,280,540\n",
      "   Invoice: 19,500\n",
      "   StockCode: 131,515\n",
      "   Description: 1,062,154\n",
      "   Country: 1,067,371\n",
      "Rows flagged as having a missing value: 243,007 of 1,067,371\n",
      "Rows with a Customer ID: 824,364\n",
      "Rows without one: 243,007\n",
      "Missing values per column:\n",
      "Description      4382\n",
      "Customer_ID    243007\n",
      "dtype: int64\n",
      "Cancelled orders: 19,494\n",
      "Returns/adjustments (non-cancelled): 3,462\n"
     ]
    }
   ],
   "source": [
    "def clean_text(series):\n",
    "    \"\"\"Strip spaces and lowercase text, blank text becomes Null\"\"\"\n",
    "    out = series.str.strip().str.lower()\n",
    "    return out.mask(out == \"\")\n",
    "\n",
    "silver_df = bronze\n",
    "\n",
    "silver_df.columns = [col.strip().replace(' ', '_') for col in silver_df.columns]\n",
    "text_cols = [c for c in silver_df.columns\n",
    "             if not pd.api.types.is_numeric_dtype(silver_df[c])\n",
    "             and not pd.api.types.is_datetime64_any_dtype(silver_df[c])]\n",
    "silver_df['InvoiceDate'] = silver_df['InvoiceDate'].dt.date\n",
    "silver_df[\"Customer_ID\"] = silver_df[\"Customer_ID\"].astype(\"Int64\")\n",
    "\n",
    "changes = {}\n",
    "for col in text_cols:\n",
    "    before = silver_df[col]\n",
    "    after = clean_text(before)\n",
    "    #a cell changed if it had a value and the cleaned value is different (or became Null)\n",
    "    changes[col] = int((before.notna() & ~before.eq(after)).sum())\n",
    "    silver_df[col] = after\n",
    "    del before, after   \n",
    "missing = silver_df.isna().sum()\n",
    "\n",
    "#Flag any row that has at least one missing value\n",
    "silver_df[\"Missing_Data\"] = silver_df.isna().any(axis=1)\n",
    "silver_df[\"Customer_ID_Exists\"] = silver_df[\"Customer_ID\"].notna()\n",
    "silver_df[\"Cancelled_Order\"] = silver_df[\"Invoice\"].str.startswith(\"c\", na=False)\n",
    "#Returns / adjustments: negative quantity or negative price on a NON-cancelled invoice\n",
    "#(stock write-offs, bad-debt entries, manual adjustments)\n",
    "silver_df[\"Return_Adjustment\"] = (\n",
    "    ((silver_df[\"Quantity\"] < 0) | (silver_df[\"Price\"] < 0))\n",
    "    & ~silver_df[\"Cancelled_Order\"]\n",
    ")

"print(\"PREVIEW (nothing saved yet)\")\n",
    "print(f\"Text columns checked: {text_cols}\")\n",
    "print(f\"Cells that WILL change: {sum(changes.values()):,}\")\n",
    "for col, n in changes.items():\n",
    "    print(f\"   {col}: {n:,}\")\n",
    "\n",
    "print(f\"Rows flagged as having a missing value: {silver_df['Missing_Data'].sum():,} of {len(silver_df):,}\")\n",
    "print(f\"Rows with a Customer ID: {silver_df['Customer_ID_Exists'].sum():,}\")\n",
    "print(f\"Rows without one: {(~silver_df['Customer_ID_Exists']).sum():,}\")\n",
    "print(\"Missing values per column:\")\n",
    "print(missing[missing > 0])\n",
    "print(f\"Cancelled orders: {silver_df['Cancelled_Order'].sum():,}\")\n",
    "print(f\"Returns/adjustments (non-cancelled): {silver_df['Return_Adjustment'].sum():,}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "becdc1f7",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Done. Saved 1,067,371 rows to the 'silver' table.\n",
      "Cells changed: 2,280,540\n",
      "Rows flagged Missing_Data: 243,007\n"
     ]
    }
   ],
   "source": [
    "answer = input(\"Apply these changes and save to the silver table? (yes/no): \").strip().lower()\n",
    "\n",
    "if answer == \"yes\":\n",
    "    con.execute(\"CREATE OR REPLACE TABLE silver AS SELECT * FROM silver_df\")\n",
    "    print(f\"Done. Saved {len(silver_df):,} rows to the 'silver' table.\")\n",
    "    print(f\"Cells changed: {sum(changes.values()):,}\")\n",
    "    print(f\"Rows flagged Missing_Data: {silver_df['Missing_Data'].sum():,}\")\n",
    "    \n",
    "else:\n",
    "    print(\"No changes saved.\")\n",
    "\n",
    "con.close()"
   ]
  },
